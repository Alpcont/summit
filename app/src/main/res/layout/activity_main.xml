<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- The current page (Today, Calendar or Someday) is built into @id/list. -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp" />
    </ScrollView>

    <!-- Appears for a few seconds after a task was deleted or moved. -->
    <LinearLayout
        android:id="@+id/undo_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_undo"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/undo_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/undo_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:fontFamily="sans-serif-medium"
            android:padding="14dp"
            android:text="@string/undo"
            android:textColor="@color/accent"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- What the quick-add understood from the typed line, e.g. "Tomorrow · 18:00 · Gym". -->
    <TextView
        android:id="@+id/quick_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="34dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="34dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/quick_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_field"
        android:gravity="center_vertical"
        android:minHeight="54dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="7dp">

        <EditText
            android:id="@+id/quick_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_dim"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/quick_more"
            style="@style/IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/more_details"
            android:src="@drawable/ic_edit" />

        <ImageButton
            android:id="@+id/quick_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_accent_round"
            android:contentDescription="@string/add_task"
            android:scaleType="center"
            android:src="@drawable/ic_up"
            android:tint="@color/on_accent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_today"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:drawableTop="@drawable/ic_peak"
            android:drawablePadding="2dp"
            android:gravity="center_horizontal"
            android:paddingTop="8dp"
            android:text="@string/tab_today"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tab_calendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:drawableTop="@drawable/ic_calendar"
            android:drawablePadding="2dp"
            android:gravity="center_horizontal"
            android:paddingTop="8dp"
            android:text="@string/tab_calendar"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tab_someday"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:drawableTop="@drawable/ic_someday"
            android:drawablePadding="2dp"
            android:gravity="center_horizontal"
            android:paddingTop="8dp"
            android:text="@string/tab_someday"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
