<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/edit_close"
            style="@style/IconButton"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close" />

        <TextView
            android:id="@+id/edit_heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/edit_save"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_accent_button"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="@string/save"
            android:textColor="@color/on_accent"
            android:textSize="15sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/edit_body"
            android:animateLayoutChanges="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="40dp">

            <EditText
                android:id="@+id/edit_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/title_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_dim"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/label_when"
                style="@style/Label" />

            <com.alp.summit.FlowLayout
                android:id="@+id/when_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Label"
                android:text="@string/label_time" />

            <com.alp.summit.FlowLayout
                android:id="@+id/time_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/label_remind"
                style="@style/Label"
                android:text="@string/label_reminder" />

            <com.alp.summit.FlowLayout
                android:id="@+id/remind_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/label_repeat"
                style="@style/Label"
                android:text="@string/label_repeat" />

            <com.alp.summit.FlowLayout
                android:id="@+id/repeat_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Label"
                android:text="@string/label_duration" />

            <com.alp.summit.FlowLayout
                android:id="@+id/duration_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Label"
                android:text="@string/label_priority" />

            <com.alp.summit.FlowLayout
                android:id="@+id/priority_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Label"
                android:text="@string/label_category" />

            <com.alp.summit.FlowLayout
                android:id="@+id/category_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Label"
                android:text="@string/label_subtasks" />

            <LinearLayout
                android:id="@+id/sub_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="4dp">

                <EditText
                    android:id="@+id/sub_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/subtask_hint"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_dim"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/sub_add"
                    style="@style/IconButton"
                    android:contentDescription="@string/add_subtask"
                    android:src="@drawable/ic_add" />
            </LinearLayout>

            <TextView
                style="@style/Label"
                android:text="@string/label_notes" />

            <EditText
                android:id="@+id/edit_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field"
                android:gravity="top"
                android:hint="@string/notes_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="3"
                android:padding="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_dim"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/edit_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/delete_task"
                android:textColor="@color/danger"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
